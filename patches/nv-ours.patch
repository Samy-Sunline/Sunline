+/// LOCAL: `VICTORY_LOAD_FIRST=1`: until the pipelines queued since the start
+/// are all made (none waiting) a draw waits for its pipeline instead of being
+/// left out, so the world is never shown with pieces missing while a cold
+/// cache fills; then the usual budget. `VICTORY_LOAD_FIRST_MAX_S` (default
+/// 900) ends it in any case.
+pub(crate) fn load_first() -> bool {
+    static ON: OnceLock<bool> = OnceLock::new();
+    static OPEN: AtomicBool = AtomicBool::new(false);
+    static BEGAN: OnceLock<Instant> = OnceLock::new();
+    static TOLD: AtomicU64 = AtomicU64::new(0);
+    if !*ON.get_or_init(|| std::env::var_os("VICTORY_LOAD_FIRST").is_some_and(|v| v == "1")) {
+        return false;
+    }
+    if OPEN.load(Ordering::Relaxed) {
+        return false;
+    }
+    let began = *BEGAN.get_or_init(Instant::now);
+    let max = std::env::var("VICTORY_LOAD_FIRST_MAX_S").ok().and_then(|v| v.trim().parse::<u64>().ok()).unwrap_or(900);
+    let left = waiting();
+    if left == 0 || began.elapsed().as_secs() >= max {
+        if !OPEN.swap(true, Ordering::Relaxed) {
+            tracing::info!(
+                seconds = began.elapsed().as_secs(),
+                left,
+                "VICTORY_LOAD_FIRST: the first pipelines are made; draws no longer wait for theirs"
+            );
+        }
+        return false;
+    }
+    let secs = began.elapsed().as_secs();
+    if secs >= TOLD.load(Ordering::Relaxed) + 5 {
+        TOLD.store(secs, Ordering::Relaxed);
+        tracing::info!(left, seconds = secs, "VICTORY_LOAD_FIRST: making the pipelines before drawing");
+    }
+    true
+}
