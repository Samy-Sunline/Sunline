+/// LOCAL: a progress bar on one console line (made, left, the pipeline just
+/// made and how long it took, the rate and the time left), at most 4 a second.
+fn bar(count: usize, total: usize, key: &str, ms: f64, began: Instant) {
+    use std::sync::atomic::AtomicU64;
+    static LAST: AtomicU64 = AtomicU64::new(0);
+    let now = began.elapsed().as_millis() as u64;
+    let last = LAST.load(Ordering::Relaxed);
+    if count < total && now.saturating_sub(last) < 250 {
+        return;
+    }
+    if LAST.compare_exchange(last, now, Ordering::Relaxed, Ordering::Relaxed).is_err() && count < total {
+        return;
+    }
+    let total = total.max(1);
+    let done = count.min(total);
+    let width = 30;
+    let filled = done * width / total;
+    let secs = began.elapsed().as_secs_f64().max(0.001);
+    let rate = done as f64 / secs;
+    let left = if rate > 0.0 { ((total - done) as f64 / rate) as u64 } else { 0 };
+    let short: String = key.chars().take(16).collect();
+    print!(
+        "\r[{}{}] {done}/{total} {:.1}%  left {}  now {short} ({ms:.0} ms)  {rate:.1}/s  ~{}h{:02}m   ",
+        "#".repeat(filled),
+        "-".repeat(width - filled),
+        done as f64 * 100.0 / total as f64,
+        total - done,
+        left / 3600,
+        left % 3600 / 60,
+    );
+    let _ = std::io::Write::flush(&mut std::io::stdout());
+    if done == total {
+        println!();
+    }
+}
